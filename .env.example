# Copy to .env and edit. Everything else is configured in the app's Settings page.
NA_DB_PASSWORD=change-me            # only the app container can reach the database; still, change it
NA_APP_MEM=1536m                    # hard backstop for the app container (the app keeps itself under its own RAM budget)
NA_DB_MEM=512m                      # hard backstop for the database container
NA_COOKIE_SECURE=false              # true once served over HTTPS
TZ=Asia/Kolkata

# Optional: Media Cloud API token (free account at search.mediacloud.org). Used by source discovery. Can also be set in Settings.
NA_MEDIACLOUD_TOKEN=

# Optional: User-Agent for Wikidata/Wikipedia, e.g. NewsAnchor/1.0 (personal news reader; you@example.com)
NA_WIKIMEDIA_USER_AGENT=
